<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"

    android:gravity="center"

    android:padding="24dp"

    android:background="@color/jarvis_black">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="J A R V I S"

        android:textSize="36sp"

        android:textStyle="bold"

        android:textColor="@color/jarvis_blue"

        android:letterSpacing="0.15"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="8dp"

        android:text="PERSONAL AI ASSISTANT"

        android:textSize="12sp"

        android:textColor="@color/jarvis_gray"/>

    <View
        android:layout_width="180dp"
        android:layout_height="2dp"

        android:layout_marginTop="18dp"

        android:background="@color/jarvis_blue"/>

    <TextView
        android:id="@+id/status"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="50dp"

        android:text="JARVIS OFFLINE"

        android:textSize="22sp"

        android:textStyle="bold"

        android:textColor="@color/jarvis_white"/>

    <TextView
        android:id="@+id/detail"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="10dp"

        android:text="Assistant is sleeping"

        android:textSize="14sp"

        android:textColor="@color/jarvis_gray"/>

    <Button
        android:id="@+id/btnStart"

        android:layout_width="230dp"
        android:layout_height="60dp"

        android:layout_marginTop="45dp"

        android:text="ACTIVATE JARVIS"/>

    <Button
        android:id="@+id/btnReminder"

        android:layout_width="230dp"
        android:layout_height="55dp"

        android:layout_marginTop="15dp"

        android:text="TEST REMINDER"/>

    <Button
        android:id="@+id/btnStop"

        android:layout_width="230dp"
        android:layout_height="55dp"

        android:layout_marginTop="10dp"

        android:text="STOP JARVIS"/>

</LinearLayout>
